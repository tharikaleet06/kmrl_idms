# KMRL IDMS - Environment Variables Configuration

# 1. Google Gemini API Key for OCR, Auto-Classification, and Vector Embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# 2. MySQL Database Configuration (for Auth, Workflow, Compliance, Geospatial, Dashboard, Admin services)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=kmrl_idms
MYSQL_USERNAME=root
MYSQL_PASSWORD=password

# 3. MongoDB Database Configuration (for Document Store & Vector Embeddings in document-service)
MONGODB_URI=mongodb://localhost:27017/kmrl_documents

# 4. Frontend & Application URLs
PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
